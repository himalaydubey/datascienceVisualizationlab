      ],
      "source": [
        "# Write your code for Question 17 here\n",
        "new_month=np.array([46500,21000,33000])\n",
        "new_month=new_month.reshape(1,3)\n",
        "energy_extended=np.concatenate((monthly_energy,new_month),axis=0)\n",
