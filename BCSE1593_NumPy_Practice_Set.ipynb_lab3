          "text": [
            "[22.9 23.8 24.5 25.1 26.8 27.4 28.1 29.2 30.4 31.5]\n",
            "[22.9 23.8 24.5]\n",
            "[29.2 30.4 31.5]\n"
          ]
        }
      ],
      "source": [
        "# Write your code for Question 9 here\n",
        "sorted_temp=np.sort(equipment_temperature)\n",
        "print(sorted_temp)\n",
