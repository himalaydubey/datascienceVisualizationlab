            " [224.4]\n",
            " [199.5]\n",
            " [270. ]\n",
            " [330. ]\n",
            " [296.8]\n",
            " [214.2]\n",
            " [166.6]\n",
            " [153.6]]\n",
            "(12, 1)\n",
            "(12, 1)\n"
          ]
        }
      ],
      "source": [
        "# Write your code for Question 24 here\n",
        "import numpy as np\n",
        "\n",
        "factors = np.array([\n",
        "    0.95, 0.96, 0.98, 1.00, 1.02, 1.05,\n",
        "    1.08, 1.10, 1.06, 1.02, 0.98, 0.96\n",
        "]).reshape(12, 1)\n",
